# Template: the installer substitutes the user, group and checkout path.
[Unit]
Description=VisionBox Multi-Camera Surveillance
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/storage
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=visionbox
Group=visionbox
WorkingDirectory=/opt/visionbox
EnvironmentFile=/opt/visionbox/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/visionbox/venv/bin/python3 scripts/surveillance.py --config config.yml --no-browser
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

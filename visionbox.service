[Unit]
Description=VisionBox Multi-Camera Surveillance
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/storage
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=night
Group=night
WorkingDirectory=/home/night/VisionBox
EnvironmentFile=/home/night/VisionBox/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/night/VisionBox/venv/bin/python3 scripts/surveillance.py --config config.yml --no-browser
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

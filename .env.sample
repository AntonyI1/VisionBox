# Copy to .env (chmod 600). Read by scripts/surveillance.py and the ${VAR} placeholders in
# config.yml, by visionbox.service (EnvironmentFile), and by scripts/camera_doctor.py.
# Keep values on their own lines: systemd does not strip trailing "# comments".

# Root for recordings, captures, datasets and zones (see storage: in config.yml).
STORAGE_DIR=/path/to/storage

# Camera credentials. Reference them from config.yml as ${CAM_USER} etc. when a camera URL
# carries credentials (the shipped config pulls from a local go2rtc restream and needs none).
# scripts/camera_doctor.py uses them for its direct RTSP/ONVIF probes.
CAM_USER=cameraUser
CAM_PASS=cameraPass
EMPIRETECH_PASS=adminPass

# Dashboard login (session cookie + login page; also accepts HTTP Basic for API/scripts).
# Leave all three unset to disable auth; setting only some of them fails closed.
# VISIONBOX_SECRET_KEY signs the session cookies; generate with: openssl rand -hex 32
VISIONBOX_AUTH_USER=admin
VISIONBOX_AUTH_PASS=change-me-to-a-long-random-string
VISIONBOX_SECRET_KEY=change-me

# Graceful self-restart (under systemd) once the process RSS stays above this many MB.
#VISIONBOX_MAX_RSS_MB=4096

# Single-camera demo scripts (camera_demo.py, motion_demo.py, detect_and_capture.py,
# capture_for_review.py) fall back to this URL when none is given on the command line.
#CAMERA_URL=rtsp://user:pass@192.168.1.50:554/stream1

# Camera doctor (scripts/camera_doctor.py, cron). Pushes go out only when NTFY_TOPIC is set;
# NTFY_URL points at a self-hosted ntfy server.
#NTFY_TOPIC=visionbox-alerts
#NTFY_URL=https://ntfy.sh
# Frigate watchdog tunables (defaults shown; the module docstring lists the DOCTOR_* rest).
#FRIGATE_API=http://127.0.0.1:5000
#FRIGATE_CONTAINER=frigate
#FRIGATE_NFS_MOUNT=/mnt/storage
#DOCTOR_WIRED_CAMERAS=front_door
#DOCTOR_RESTART_COOLDOWN_S=1800
#DOCTOR_LINK_LOSS_PCT=20
#DOCTOR_LINK_RTT_MS=150
#DOCTOR_LINK_ALERT_REPEAT_S=21600
#DOCTOR_CAPTURE_RSS_ALERT_MB=1500

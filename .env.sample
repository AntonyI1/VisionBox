STORAGE_DIR=/path/to/storage
CAM_USER=cameraUser
CAM_PASS=cameraPass
EMPIRETECH_PASS=adminPass

# Dashboard HTTP Basic auth. Leave BOTH unset to disable (localhost is always exempt).
# Set them to require a login for any non-localhost (tailnet/LAN) access.
VISIONBOX_AUTH_USER=admin
VISIONBOX_AUTH_PASS=change-me-to-a-long-random-string

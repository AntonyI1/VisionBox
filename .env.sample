# Copy to .env (chmod 600). Read by scripts/surveillance.py (and the ${VAR} placeholders in
# config.yml), by visionbox.service as its EnvironmentFile, by scripts/camera_doctor.py, and by
# the demo, tool and training scripts for STORAGE_DIR and CAMERA_URL.
# Keep values on their own lines: systemd does not strip trailing "# comments".

# Root for recordings, captures, datasets and zones (see storage: in config.yml).
STORAGE_DIR=/path/to/storage

# Camera credentials, referenced as ${CAM_USER} / ${CAM_PASS} from camera URLs in config.yml and in
# the camera doctor's DOCTOR_CAMERA_*_RTSP entries below (the shipped config pulls from a local
# go2rtc restream and needs none). Add a variable per distinct camera login.
CAM_USER=cameraUser
CAM_PASS=cameraPass

# Dashboard login (session cookie + login page; also accepts HTTP Basic for API/scripts).
# Leave user and password unset to disable auth; setting only one of them fails closed.
VISIONBOX_AUTH_USER=admin
VISIONBOX_AUTH_PASS=change-me-to-a-long-random-string
# VISIONBOX_SECRET_KEY signs the session cookies. Unset, a random key is generated at startup and
# every restart ends all sessions; set it to keep them, with a value from: openssl rand -hex 32
#VISIONBOX_SECRET_KEY=

# Graceful self-restart (under systemd) once the process RSS stays above this many MB.
#VISIONBOX_MAX_RSS_MB=4096
# Options for OpenCV's ffmpeg RTSP reader (default: TCP transport, 5 s stall timeout).
#OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp|timeout;5000000

# Single-camera demo scripts (camera_demo.py, motion_demo.py, detect_and_capture.py) fall back
# to this URL when none is given on the command line.
#CAMERA_URL=rtsp://user:pass@<camera-ip>:554/stream1

# Camera doctor (scripts/camera_doctor.py, cron). Pushes go out only when NTFY_TOPIC is set;
# NTFY_URL points at a self-hosted ntfy server.
#NTFY_TOPIC=visionbox-alerts
#NTFY_URL=https://ntfy.sh
# A push that fails on NTFY_URL is retried here. A self-hosted server on the tailnet is unreachable
# exactly when the box falls off the tailnet, so use a topic elsewhere; public ntfy.sh works because
# pushes carry no secrets (anyone who knows the topic can read it, so pick a random name).
#NTFY_FALLBACK_URL=https://ntfy.sh
#NTFY_FALLBACK_TOPIC=visionbox-<random>
# Cameras the doctor probes directly. DOCTOR_CAMERAS lists the names; per camera (name upper-cased)
# _RTSP is its own endpoint with credentials, _RESTREAM the go2rtc stream name (default: the name)
# and _ONVIF the SystemReboot target host[:port] (default: the RTSP host on port 80, same login).
#DOCTOR_CAMERAS=front_door,backyard
#DOCTOR_CAMERA_FRONT_DOOR_RTSP=rtsp://${CAM_USER}:${CAM_PASS}@<camera-ip>:554/stream1
#DOCTOR_CAMERA_FRONT_DOOR_RESTREAM=front_door_sub
#DOCTOR_CAMERA_FRONT_DOOR_ONVIF=<camera-ip>:80
#DOCTOR_CAMERA_BACKYARD_RTSP=rtsp://${CAM_USER}:${CAM_PASS}@<camera-ip>:554/stream1
# Tailnet watch: proxied Frigate URL probed end to end, LAN address quoted in pushes, key-expiry
# warning window in days, repeat interval of the tailnet pushes in seconds.
#DOCTOR_PUBLIC_URL=https://frigate.example.com/api/version
#DOCTOR_FRIGATE_LAN_URL=http://<lan-ip>:5000
#DOCTOR_TS_EXPIRY_WARN_DAYS=14
#DOCTOR_TS_ALERT_REPEAT_S=21600
# Frigate watchdog tunables (defaults shown; the module docstring explains the policy).
#FRIGATE_API=http://127.0.0.1:5000
#FRIGATE_CONTAINER=frigate
#FRIGATE_NFS_MOUNT=/mnt/storage
#DOCTOR_WIRED_CAMERAS=front_door
# Seconds after a Frigate (re)start during which nothing is restarted again, and between restarts.
#DOCTOR_WARMUP_S=600
#DOCTOR_RESTART_COOLDOWN_S=1800
# Repeat interval of the "needs a human" push for faults the policy will not restart for.
#DOCTOR_HUMAN_REPEAT_S=21600
# Link health: ping loss / RTT that mark a link unhealthy, how long the state must hold before a
# "degraded" or "recovered" push, and the per-camera repeat interval of those pushes.
#DOCTOR_LINK_LOSS_PCT=20
#DOCTOR_LINK_RTT_MS=150
#DOCTOR_LINK_HOLD_S=900
#DOCTOR_LINK_ALERT_REPEAT_S=21600
# go2rtc producer check: seconds between the two samples and the byte rate below which a
# stream counts as starved; pings sent per camera per run.
#DOCTOR_PRODUCER_SAMPLE_S=6
#DOCTOR_PRODUCER_MIN_BPS=1000
#DOCTOR_PING_COUNT=10
#DOCTOR_CAPTURE_RSS_ALERT_MB=1500
# Run a copy of the doctor against the live box without touching its state: point these at a
# copy of the state file and at an .env without the real credentials.
#DOCTOR_STATE_FILE=logs/camera_doctor_state.json
#DOCTOR_ENV_FILE=.env

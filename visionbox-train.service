# Template: the installer substitutes the user, group and checkout path.
[Unit]
Description=VisionBox nightly self-training (assemble -> train -> gate -> stage/promote)
After=network-online.target visionbox.service
Wants=network-online.target

[Service]
Type=oneshot
User=visionbox
Group=visionbox
WorkingDirectory=/opt/visionbox
# Yield to live surveillance: training is best-effort and never starves the cameras.
Nice=15
CPUWeight=20
IOSchedulingClass=idle
# Stage-only by default. Uncomment to hot-swap whenever the regression gate passes:
#Environment=AUTO_PROMOTE=1
ExecStart=/opt/visionbox/scripts/training/run_overnight.sh
TimeoutStartSec=6h
